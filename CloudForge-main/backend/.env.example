# CloudForge Backend Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=production

# Database
# Option 1: MongoDB Atlas (Recommended)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/cloudforge?appName=Cluster0

# Option 2: Local MongoDB (if running MongoDB on same EC2)
# MONGODB_URI=mongodb://localhost:27017/cloudforge

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Firebase Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FIREBASE_API_KEY=your-firebase-api-key

# Frontend Client URL (for development/debugging)
CLIENT_URL=http://localhost:3000

# Optional: Socket.IO Namespace
SOCKET_NAMESPACE=/socket.io

# Optional: Logging Level
LOG_LEVEL=info
